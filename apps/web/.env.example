# Variáveis PÚBLICAS do app (embutidas no bundle). Nunca coloque segredos aqui.

# URL da API FastAPI
VITE_API_BASE_URL=http://localhost:8000

# Origem dos dados: "mock" (demonstração, padrão) ou "api"
VITE_DATA_SOURCE=mock

# ---------- Login real com Google (Google Identity Services + Supabase Auth) ----------
# O login real só é ativado quando as TRÊS variáveis abaixo estão preenchidas.
# Sem elas, o app funciona apenas como demonstração (padrão).
# Guia: docs/frontend/auth-integration.md
#
# Projeto edusearch-db
VITE_SUPABASE_URL=https://pgltvnwdvatyihrozlvn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_D07zYNPzKEXRSU3uciN-pg_D5M91QnB
# Client ID OAuth "Aplicativo da Web" (termina em .apps.googleusercontent.com).
# NUNCA coloque o Client Secret (GOCSPX-...) no frontend.
VITE_GOOGLE_CLIENT_ID=

# ---------- Documentos jurídicos (públicos) ----------
# Defina SOMENTE quando os documentos estiverem publicados. Sem elas, a tela de entrada
# informa que estão em elaboração (nunca simula aceite).
VITE_LEGAL_TERMS_URL=
VITE_LEGAL_PRIVACY_URL=

# ---------- Estágio de cada recurso (off | testing | production) ----------
# Um indicador por recurso: nada libera autenticação, cadastros e pagamentos de uma vez.
# "production" só vale com os documentos jurídicos publicados (VITE_LEGAL_*);
# sem eles, o estágio cai para "testing". Pagamentos: sempre simulados nesta fase.
# Login Google (padrão: testing, quando configurado)
VITE_STAGE_GOOGLE_AUTH=testing
# Entrar com e-mail e senha (padrão: off). Ver docs/legal/checklist-publicacao.md, seção 6.
VITE_STAGE_EMAIL_AUTH=off
# Criar conta com e-mail e senha (padrão: off; nunca acima de VITE_STAGE_EMAIL_AUTH)
VITE_STAGE_EMAIL_SIGNUP=off
# Persistência REAL do perfil/onboarding na API FastAPI (Fase 2.6B). Padrão: off.
# off = prévia sem envio (deployments públicos). testing = papel e cadastro salvos na API
# (exige login real e VITE_API_BASE_URL apontando para a API). Ver docs/frontend/profile-persistence.md.
VITE_STAGE_PROFILE_PERSISTENCE=off
