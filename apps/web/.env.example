# Variáveis PÚBLICAS do app (embutidas no bundle). Nunca coloque segredos aqui.

# URL da API FastAPI
VITE_API_BASE_URL=http://localhost:8000

# Origem dos dados: "mock" (demonstração, padrão) ou "api"
VITE_DATA_SOURCE=mock

# ---------- Login real com Google (Supabase Auth) ----------
# Desligado por padrão. Ligue SOMENTE no ambiente restrito de testes
# (local ou preview). A versão pública continua apenas com a demonstração.
# Guia: docs/frontend/auth-integration.md
VITE_AUTH_GOOGLE_ENABLED=false
# Projeto edusearch-db
VITE_SUPABASE_URL=https://pgltvnwdvatyihrozlvn.supabase.co
# Chave PUBLICÁVEL (Dashboard → Project Settings → API Keys → Publishable key).
# NUNCA use a service_role / secret key no frontend.
VITE_SUPABASE_PUBLISHABLE_KEY=
