# Variáveis PÚBLICAS do app (embutidas no bundle). Nunca coloque segredos aqui.

# URL da API FastAPI
VITE_API_BASE_URL=http://localhost:8000

# Origem dos dados: "mock" (demonstração, padrão) ou "api"
VITE_DATA_SOURCE=mock

# ---------- Login real com Google (Google Identity Services + Supabase Auth) ----------
# O login real só é ativado quando as TRÊS variáveis abaixo estão preenchidas.
# Sem elas, o app funciona apenas como demonstração (padrão).
# Guia: docs/frontend/auth-integration.md
#
# Projeto edusearch-db
VITE_SUPABASE_URL=https://pgltvnwdvatyihrozlvn.supabase.co
# Chave PUBLICÁVEL (Supabase → Project Settings → API Keys → Publishable key).
# NUNCA use a service_role / secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Client ID OAuth "Aplicativo da Web" (termina em .apps.googleusercontent.com).
# NUNCA coloque o Client Secret (GOCSPX-...) no frontend.
VITE_GOOGLE_CLIENT_ID=

# ---------- Documentos jurídicos (públicos) ----------
# Defina SOMENTE quando os documentos estiverem publicados. Sem elas, a tela de entrada
# informa que estão em elaboração (nunca simula aceite).
VITE_LEGAL_TERMS_URL=
VITE_LEGAL_PRIVACY_URL=
