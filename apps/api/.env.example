# Copie para apps/api/.env (ignorado pelo Git). Somente placeholders aqui — nunca valores reais.

# development | staging | production. Em production a API recusa papel de conexão privilegiado.
API_ENVIRONMENT=development

# Origens EXATAS liberadas no CORS (sem curinga). http só para localhost.
# Produção (após aprovação): https://app.edusearch.com.br
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5190

# Origem do projeto Supabase. Define o emissor (…/auth/v1) e o JWKS usados para validar o JWT.
# Local (supabase start): http://127.0.0.1:54321
API_SUPABASE_URL=https://<project-ref>.supabase.co
API_JWT_AUDIENCE=authenticated
# Somente algoritmos assimétricos (o projeto usa ES256). HS256 não é aceito.
API_JWT_ALGORITHMS=ES256

# PostgreSQL. Conecte como edusearch_api (menor privilégio; NUNCA postgres/service_role em
# produção). Ver docs/database-design.md → "Conexão da API". NUNCA commitar a senha.
# Remoto (pooler, modo transação): usuário edusearch_api.<project-ref>, porta 6543.
# Local (supabase start/db start) aceita postgres:postgres apenas para desenvolvimento.
API_DATABASE_URL=postgresql://edusearch_api.<project-ref>:<senha>@<pooler-host>:6543/postgres?sslmode=require
API_DB_POOL_MAX_SIZE=5
API_DB_STATEMENT_TIMEOUT_MS=5000

# Hosts aceitos para avatar_url (sufixos). O host do projeto Supabase é incluído automaticamente.
API_AVATAR_ALLOWED_HOST_SUFFIXES=googleusercontent.com

# ------------------------------------------------------------------ Agenda (Fase 3A)
# off (padrão) | testing. Em off, todas as rotas de agenda/aulas respondem 403.
API_SCHEDULING_STAGE=off
# Google Agenda/Meet: o MESMO cliente OAuth Web do login. O segredo só existe aqui (nunca no app).
API_GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
API_GOOGLE_OAUTH_CLIENT_SECRET=<segredo — só no servidor>
# URI EXATA cadastrada no Google Cloud (página do app que repassa o código à API).
API_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/conta/agenda/google/retorno
# Chave AES-256 (base64url, 32 bytes) do refresh token. Gere com:
#   python -c "from app.crypto import generate_key; print(generate_key())"
# Trocar a chave exige que os professores reconectem (aumente a versão).
API_TOKEN_ENCRYPTION_KEY=<chave — nunca commitar>
API_TOKEN_ENCRYPTION_KEY_VERSION=1

# ------------------------------------------------------------------ Pagamentos Pix (Fase 5)
# off (padrão) | sandbox | production. Detalhes e checklist em docs/payments.md.
#   sandbox    → exige chave abc_dev_ (Modo Teste da AbacatePay; nenhum dinheiro real).
#   production → exige chave abc_prod_ E API_PAYMENTS_PRODUCTION_APPROVED=true (aprovação operacional).
# Uma chave abc_prod_ fora de production IMPEDE a API de iniciar.
API_PAYMENTS_STAGE=off
API_ABACATEPAY_API_KEY=<abc_dev_... — só no servidor, nunca commitar>
# Segredo escolhido por você ao cadastrar o webhook no painel (≥ 32 caracteres aleatórios).
API_ABACATEPAY_WEBHOOK_SECRET=<segredo do webhook — nunca commitar>
# Chave pública HMAC publicada pela AbacatePay em docs.abacatepay.com → Webhooks → Segurança.
API_ABACATEPAY_WEBHOOK_PUBLIC_KEY=<copiar da documentação oficial>
# Split para a subconta do professor: só depois que o suporte da AbacatePay habilitar na conta.
API_ABACATEPAY_SPLIT_ENABLED=false
API_PAYMENTS_PRODUCTION_APPROVED=false
# Saques reais são bloqueados por padrão, inclusive em production.
API_SUBACCOUNT_WITHDRAWALS_ENABLED=false
# Tempo de reserva do horário enquanto o Pix não é pago (300–3600 s).
API_PAYMENTS_HOLD_SECONDS=900

# ------------------------------------------------------------------ Notificações transacionais (Resend)
# off (padrão) | sandbox | production. Nenhum envio é ativado por este arquivo.
API_NOTIFICATIONS_STAGE=off
# Preencha somente no painel seguro da API/Vercel após verificar o domínio no Resend.
API_RESEND_API_KEY=<re_... — só no servidor, nunca commitar>
API_RESEND_FROM=EduSearch <notificacoes@mail.edusearch.com.br>
API_RESEND_TIMEOUT_SECONDS=10
API_NOTIFICATIONS_DISPATCH_SECRET=<configure-identically-in-vercel-and-cloudflare>
API_NOTIFICATIONS_BATCH_SIZE=10

# ------------------------------------------------------------------ Trust Engine (credenciamento)
# Sem segredo (>= 32 caracteres), POST /v1/internal/trust/dispatch recusa toda chamada.
# O Trust Engine só aprova com todos os requisitos obrigatórios comprovados.
API_TRUST_DISPATCH_SECRET=<somente no servidor, nunca commitar>
API_TRUST_BATCH_SIZE=10
# Orçamento por chamada (abaixo do maxDuration da função na Vercel).
API_TRUST_DISPATCH_BUDGET_SECONDS=8
# Somente "none" está implementado: identidade e formação ficam pendentes sem provedor confiável.
API_TRUST_IDENTITY_PROVIDER=none
API_TRUST_ACADEMIC_REGISTRY=none
API_TEACHER_TERMS_VERSION=teacher-terms-2026-11
# Chave PUBLICÁVEL do Supabase (não é segredo) para inspecionar documentos com o token do titular.
API_SUPABASE_PUBLISHABLE_KEY=

# Documentação interativa (/docs). Desligue em produção se preferir.
API_ENABLE_DOCS=true

# Apenas para testes de banco (pytest tests/db). Banco DESCARTÁVEL, nunca o de produção.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
