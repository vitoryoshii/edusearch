# Copie para apps/api/.env (ignorado pelo Git). Somente placeholders aqui — nunca valores reais.

# development | staging | production (apenas informativo nesta fase)
API_ENVIRONMENT=development

# Origens EXATAS liberadas no CORS (sem curinga). http só para localhost.
# Produção (após aprovação): https://app.edusearch.com.br
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5190

# Origem do projeto Supabase. Define o emissor (…/auth/v1) e o JWKS usados para validar o JWT.
# Local (supabase start): http://127.0.0.1:54321
API_SUPABASE_URL=https://<project-ref>.supabase.co
API_JWT_AUDIENCE=authenticated
# Somente algoritmos assimétricos (o projeto usa ES256). HS256 não é aceito.
API_JWT_ALGORITHMS=ES256

# PostgreSQL. O papel de conexão precisa poder executar "SET ROLE authenticated"
# (ver docs/database-design.md → "Conexão da API"). NUNCA commitar a senha.
# Local (supabase start/db start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
API_DATABASE_URL=postgresql://<usuario>:<senha>@<host>:<porta>/postgres?sslmode=require
API_DB_POOL_MAX_SIZE=5
API_DB_STATEMENT_TIMEOUT_MS=5000

# Hosts aceitos para avatar_url (sufixos). O host do projeto Supabase é incluído automaticamente.
API_AVATAR_ALLOWED_HOST_SUFFIXES=googleusercontent.com

# Documentação interativa (/docs). Desligue em produção se preferir.
API_ENABLE_DOCS=true

# Apenas para testes de banco (pytest tests/db). Banco DESCARTÁVEL, nunca o de produção.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
