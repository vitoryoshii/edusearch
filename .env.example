# EduSearch — variáveis de ambiente de exemplo
# Copie para .env (ou apps/api/.env) e preencha. Nunca versione valores reais.

# ---------- API (apps/api) ----------
# Origens liberadas no CORS durante o desenvolvimento (separadas por vírgula)
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Frontend (apps/web) ----------
VITE_API_URL=http://localhost:8000

# ---------- Integrações de servidor (nunca expor no frontend) ----------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# As variáveis API_* pertencem à API/Vercel; veja apps/api/.env.example e docs/production-readiness.md.
